## luced-message's entry point: run the window. `--smoke` draws three frames and
## exits; `--home DIR` keeps settings, accounts and the store in DIR.
from app import LuceMessage

pub func main(arguments: list[str]) -> int!:
    var directory = ""
    for at in 0..<arguments.length - 1:
        if arguments[at] == "--home":
            directory = arguments[at + 1]
    let messenger = LuceMessage(directory)
    messenger.run(arguments)
    messenger.close()
    return 0
