## The mail engine for one email account, on its own thread. It keeps one IMAP
## session: it lists the folders, brings each folder's index up to date (new messages'
## headers, everyone's flags, expunges), prefetches the newest INBOX bodies, then
## waits in IDLE on INBOX until the server has news or the window has a command.
## Commands (fetch a body, change flags, move, send) run between those steps. Every
## change is written to the store first and then announced as an event, so the window
## only ever reads files.
##
## Commands, tab-separated:   sync | body PATH UID | flags PATH UIDS ADD BITS |
##                            move PATH UIDS TARGET | send FILE FROM RECIPIENTS
## Events:                    online | offline TEXT | status TEXT | folders |
##                            folder PATH | body PATH UID | sent FILE | unsent FILE TEXT |
##                            error TEXT
import c
import files
import imap
import memory
import mime
import net
import smtp
import thread
import time
import tls_stream
from engine_text import Buffer, Pool, Records, Fields, equal
from mail_store import Index, Row, Folder, save_folders, put_key, ensure_path
from mail_queue import Mailroom

## The headers a message list needs, fetched for every new message.
let summary_fields: str = "DATE FROM SUBJECT MESSAGE-ID IN-REPLY-TO CONTENT-TYPE"
## How many messages' headers one FETCH asks for.
let batch_size: usize = 400
## How many of INBOX's newest bodies are fetched ahead of being opened.
let prefetch_count: usize = 25
## A full sync of every folder at least this often, in nanoseconds.
let full_sync_interval: u64 = 10 * 60 * 1000000000
## One slice of an IDLE wait, between looks at the mailroom.
let idle_slice: u64 = 500000000
## How long to wait before reconnecting after a failure.
let retry_delay: u64 = 30 * 1000000000

## The account the engine serves, read from its configuration line.
struct Account:
    var id: str
    var root: str
    var imap_host: str
    var imap_port: u16
    var imap_security: imap.Security
    var user: str
    var password: str
    var smtp_host: str
    var smtp_port: u16
    var smtp_security: smtp.Security
    var smtp_user: str
    var smtp_password: str

## The security named `name`: plain, starttls or tls.
func imap_security(name: const u8[]) -> imap.Security:
    if equal(name, b"plain"):
        return imap.Security.plain
    if equal(name, b"starttls"):
        return imap.Security.starttls
    return imap.Security.tls

func smtp_security(name: const u8[]) -> smtp.Security:
    if equal(name, b"plain"):
        return smtp.Security.plain
    if equal(name, b"tls"):
        return smtp.Security.tls
    return smtp.Security.starttls

pub struct Engine:
    var room: Mailroom*
    var text: Pool
    var account: Account
    var session: imap.Session
    var online: bool
    var folders: Records[Folder]
    var folder_text: Pool
    var selected: Buffer
    var last_full_sync: u64
    var wants_full_sync: bool
    var retry_at: u64

    ## An engine for the account in `room`'s configuration line.
    pub static func create(room: Mailroom*) -> Engine!:
        var engine = Engine(room = room, account = Account(id = "", root = "", imap_host = "", imap_port = 993, imap_security = imap.Security.tls, user = "", password = "", smtp_host = "", smtp_port = 587, smtp_security = smtp.Security.starttls, smtp_user = "", smtp_password = ""), wants_full_sync = true)
        errdefer engine.close()
        let fields = Fields.split(room.config.view())
        var scratch: Buffer
        defer scratch.close()
        engine.account.id = try engine.config_field(&fields, 0, &scratch)
        engine.account.root = try engine.config_field(&fields, 1, &scratch)
        engine.account.imap_host = try engine.config_field(&fields, 2, &scratch)
        engine.account.imap_port = (u16)fields.number(3)
        engine.account.imap_security = imap_security(fields.raw(4))
        engine.account.user = try engine.config_field(&fields, 5, &scratch)
        engine.account.password = try engine.config_field(&fields, 6, &scratch)
        engine.account.smtp_host = try engine.config_field(&fields, 7, &scratch)
        engine.account.smtp_port = (u16)fields.number(8)
        engine.account.smtp_security = smtp_security(fields.raw(9))
        engine.account.smtp_user = try engine.config_field(&fields, 10, &scratch)
        engine.account.smtp_password = try engine.config_field(&fields, 11, &scratch)
        return engine

    mutating func config_field(fields: const Fields*, at: usize, scratch: Buffer*) -> str!:
        scratch.clear()
        try fields.unescape(at, scratch)
        return try self.text.keep_text(scratch.view())

    # mark: events ===============================================================================

    ## Post an event of `kind` with up to three fields.
    mutating func post(kind: str, first: const u8[] = b"", second: const u8[] = b"", third: const u8[] = b""):
        var line: Buffer
        defer line.close()
        line.text(kind) catch failure:
            return
        for field in [first, second, third]:
            if field.length == 0:
                continue
            line.byte('\t') catch failure:
                return
            line.field(field) catch failure:
                return
        self.room.post(line.view())

    # mark: the loop =============================================================================

    ## Serve the account until the window stops the engine.
    pub mutating func run():
        while not self.room.stopped():
            self.step() catch failure:
                if self.room.stopped():
                    return
                self.go_offline(failure.message)
                recover ()

    ## One turn: connect if needed, run a waiting command, sync when due, else wait.
    mutating func step() -> !:
        if not self.online:
            if time.now() < self.retry_at:
                self.pause()
                return
            try self.connect()
        var command: Buffer
        defer command.close()
        if try self.room.take(&command):
            try self.handle(command.view())
            return
        if self.wants_full_sync or time.now() - self.last_full_sync > full_sync_interval:
            try self.sync_all()
            return
        try self.watch()

    ## Wait a moment for a command or the end, while offline.
    mutating func pause():
        var waited: u64 = 0
        while waited < 1000 and not self.room.stopped() and not self.room.has_command():
            thread.sleep(50)
            waited += 50

    ## Close the session and say why; reconnect after a while.
    mutating func go_offline(reason: str):
        if self.online:
            self.session.close()
        self.online = false
        self.selected.clear()
        self.retry_at = time.now() + retry_delay
        self.post("offline", reason.bytes)

    ## Connect and log in.
    mutating func connect() -> !:
        self.post("status", b"Connecting")
        self.session = try imap.Session.open(self.account.imap_host, self.account.imap_port, self.account.imap_security, cancellation = &self.room.quit)
        self.online = true
        try self.session.login(self.account.user, self.account.password)
        self.wants_full_sync = true
        self.post("online")

    # mark: commands =============================================================================

    ## Run one command line from the window.
    mutating func handle(line: const u8[]) -> !:
        let fields = Fields.split(line)
        let name = fields.raw(0)
        var path: Buffer
        defer path.close()
        try fields.unescape(1, &path)
        if equal(name, b"sync"):
            self.wants_full_sync = true
        elif equal(name, b"body"):
            try self.fetch_body(path.view(), (u32)fields.number(2))
        elif equal(name, b"flags"):
            var uids: Buffer
            defer uids.close()
            try fields.unescape(2, &uids)
            try self.set_flags(path.view(), uids.view(), fields.number(3) != 0, (u16)fields.number(4))
        elif equal(name, b"move"):
            var uids: Buffer
            defer uids.close()
            try fields.unescape(2, &uids)
            var target: Buffer
            defer target.close()
            try fields.unescape(3, &target)
            try self.move(path.view(), uids.view(), target.view())
        elif equal(name, b"send"):
            var sender: Buffer
            defer sender.close()
            try fields.unescape(2, &sender)
            var recipients: Buffer
            defer recipients.close()
            try fields.unescape(3, &recipients)
            self.send(path.view(), sender.view(), recipients.view())

    # mark: paths ================================================================================

    ## `<root>/<account>` onto `out`.
    func account_directory(out: Buffer*) -> !:
        out.clear()
        try out.text(self.account.root)
        try out.byte('/')
        try out.text(self.account.id)

    ## `<root>/<account>/<key>` for folder `path` onto `out`.
    func folder_directory(path: const u8[], out: Buffer*) -> !:
        try self.account_directory(out)
        try out.byte('/')
        try put_key(path, out)

    ## `<folder directory>/<name>` onto `out`.
    func folder_file(path: const u8[], name: const u8[], out: Buffer*) -> !:
        try self.folder_directory(path, out)
        try out.byte('/')
        try out.put(name)

    ## `<folder directory>/<uid>.eml` onto `out`.
    func message_file(path: const u8[], uid: u32, out: Buffer*) -> !:
        try self.folder_directory(path, out)
        try out.byte('/')
        try out.number((i64)uid)
        try out.put(b".eml")

    # mark: selecting ============================================================================

    ## Select folder `path` unless it is already.
    mutating func select(path: const u8[]) -> imap.Selected!:
        if equal(self.selected.view(), path) and self.session.is_selected():
            return self.session.selected
        self.selected.clear()
        let state = try self.session.select((str)path)
        try self.selected.put(path)
        return state

    # mark: syncing ==============================================================================

    ## List the folders and bring every one up to date.
    mutating func sync_all() -> !:
        self.wants_full_sync = false
        self.last_full_sync = time.now()
        self.post("status", b"Checking for mail")
        try self.list_folders()
        for at in 0..<self.folders.length():
            if self.room.stopped():
                return
            try self.sync_folder(at)
            # A command the window is waiting on goes before the remaining folders.
            var command: Buffer
            defer command.close()
            while try self.room.take(&command):
                try self.handle(command.view())
        try self.save_folders()
        self.post("folders")
        self.post("status", b"")

    ## Learn the folders, INBOX first, and write the folders file.
    mutating func list_folders() -> !:
        let mailboxes = try self.session.list()
        self.folders.clear()
        self.folder_text.close()
        var key: Buffer
        defer key.close()
        # INBOX first: it is what the user looks at.
        for pass in 0..<2:
            for mailbox in mailboxes:
                let inbox = imap.same(mailbox.path, b"INBOX")
                if (pass == 0) != inbox or mailbox.is(imap.MailboxFlags.no_select):
                    continue
                key.clear()
                try put_key(mailbox.path, &key)
                try self.folders.add(Folder(path = try self.folder_text.keep_text(mailbox.path), name = try self.folder_text.keep_text(mailbox.name.bytes),
                                            delimiter = mailbox.delimiter, flags = (u32)mailbox.flags, key = try self.folder_text.keep_text(key.view())))
        try self.save_folders()
        self.post("folders")

    ## Write the folders file.
    mutating func save_folders() -> !:
        var path: Buffer
        defer path.close()
        try self.account_directory(&path)
        try ensure_path(path.text_view())
        try path.put(b"/folders")
        try save_folders(try path.terminated(), self.folders.view())

    ## Bring folder number `at` up to date.
    mutating func sync_folder(at: usize) -> !:
        let folder = self.folders.at(at)
        let path = folder.path.bytes
        var directory: Buffer
        defer directory.close()
        try self.folder_directory(path, &directory)
        try ensure_path(directory.text_view())
        var index_path: Buffer
        defer index_path.close()
        try self.folder_file(path, b"index", &index_path)
        var index = try Index.load(try index_path.terminated())
        defer index.close()
        let state = try self.select(path)
        if index.uid_validity != state.uid_validity:
            index.clear()
            index.uid_validity = state.uid_validity
        # Flags of the messages held, and which are gone.
        if index.rows.length() > 0 and state.exists > 0:
            try self.refresh_flags(&index)
        elif state.exists == 0 and index.rows.length() > 0:
            index.clear()
            index.uid_validity = state.uid_validity
        # New messages: their headers, newest batches first.
        if state.exists > 0 and (state.uid_next == 0 or state.uid_next > index.last_uid() + 1):
            try self.fetch_new(path, &index, &index_path)
        index.uid_next = state.uid_next
        if index.changed:
            try index.save(try index_path.terminated())
            self.post("folder", path)
        var updated = folder
        updated.total = (u32)index.rows.length()
        updated.unseen = index.unseen()
        self.folders.set(at, updated)
        if imap.same(path, b"INBOX"):
            try self.prefetch(path, &index, &index_path)

    ## Update every held row's flags and drop the rows the server no longer has.
    mutating func refresh_flags(index: Index*) -> !:
        var set: Buffer
        defer set.close()
        try set.put(b"1:")
        try set.number((i64)index.last_uid())
        let records = try self.session.fetch(set.text_view(), "(UID FLAGS)")
        var seen: Records[bool]
        defer seen.close()
        while seen.length() < index.rows.length():
            try seen.add(false)
        for record in records:
            if let at = index.find(record.uid):
                seen.set(at, true)
                var row = index.rows.at(at)
                if record.has_flags and row.flags != (u16)record.flags:
                    row.flags = (u16)record.flags
                    index.rows.set(at, row)
                    index.changed = true
        var at = index.rows.length()
        while at > 0:
            at -= 1
            if not seen.at(at):
                index.rows.remove(at)
                index.changed = true

    ## Fetch the headers of messages newer than the index holds.
    mutating func fetch_new(path: const u8[], index: Index*, index_path: Buffer*) -> !:
        var criteria: Buffer
        defer criteria.close()
        try criteria.put(b"UID ")
        try criteria.number((i64)index.last_uid() + 1)
        try criteria.put(b":*")
        let found = try self.session.search(criteria.text_view())
        var uids: Records[u32]
        defer uids.close()
        for uid in found:
            if uid > index.last_uid():
                try uids.add(uid)
        var end = uids.length()
        while end > 0:
            let start = end - batch_size if end > batch_size else 0
            var set: imap.Bytes
            defer set.close()
            try imap.write_set(uids.view()[start..<end], &set)
            let records = try self.session.fetch_headers((str)set.view(), summary_fields)
            for record in records:
                try index.put(try summarize(&record, index))
            try index.save(try index_path.terminated())
            self.post("folder", path)
            end = start
            if self.room.has_command() or self.room.stopped():
                # The rest arrives on the next sync; the window's command goes first.
                self.wants_full_sync = true
                return

    ## Fetch INBOX's newest bodies that are not in the store yet.
    mutating func prefetch(path: const u8[], index: Index*, index_path: Buffer*) -> !:
        var fetched: usize = 0
        var at = index.rows.length()
        var file: Buffer
        defer file.close()
        while at > 0 and fetched < prefetch_count:
            at -= 1
            if self.room.has_command() or self.room.stopped():
                break
            let uid = index.rows.at(at).uid
            try self.message_file(path, uid, &file)
            if files.exists(try file.terminated()):
                continue
            try self.store_body(path, uid, index, &file)
            fetched += 1
        if index.changed:
            try index.save(try index_path.terminated())
            self.post("folder", path)

    ## Fetch message `uid` of the selected folder `path` into `file`, and fill its row's
    ## preview from it.
    mutating func store_body(path: const u8[], uid: u32, index: Index*, file: Buffer*) -> !:
        let data = try self.session.fetch_message(uid)
        if data.length == 0:
            return
        try files.write_atomic(try file.terminated(), data)
        if let at = index.find(uid):
            var message = try mime.Message.read(data)
            defer message.close()
            var row = index.rows.at(at)
            row.preview = try index.keep(try message.preview().bytes)
            row.attachment = try message.attachment_count() > 0
            index.rows.set(at, row)
            index.changed = true

    ## Fetch message `uid` of folder `path` for the window, which waits for it.
    mutating func fetch_body(path: const u8[], uid: u32) -> !:
        var file: Buffer
        defer file.close()
        try self.message_file(path, uid, &file)
        if not files.exists(try file.terminated()):
            discard(try self.select(path))
            var index_path: Buffer
            defer index_path.close()
            try self.folder_file(path, b"index", &index_path)
            var index = try Index.load(try index_path.terminated())
            defer index.close()
            try self.store_body(path, uid, &index, &file)
            if index.changed:
                try index.save(try index_path.terminated())
                self.post("folder", path)
        var number: Buffer
        defer number.close()
        try number.number((i64)uid)
        self.post("body", path, number.view())

    # mark: changes ==============================================================================

    ## Add (`add`) or remove flag bits `bits` on messages `uids` of folder `path`.
    mutating func set_flags(path: const u8[], uids: const u8[], add: bool, bits: u16) -> !:
        discard(try self.select(path))
        try self.session.store((str)uids, (imap.Flags)bits, add)
        try self.update_index(path, uids, bits, add, false)

    ## Move messages `uids` of folder `path` to folder `target`.
    mutating func move(path: const u8[], uids: const u8[], target: const u8[]) -> !:
        discard(try self.select(path))
        try self.session.move((str)uids, (str)target)
        try self.update_index(path, uids, 0, false, true)
        self.wants_full_sync = true

    ## Apply a flag change or a removal to folder `path`'s index and announce it.
    mutating func update_index(path: const u8[], uids: const u8[], bits: u16, add: bool, remove: bool) -> !:
        var index_path: Buffer
        defer index_path.close()
        try self.folder_file(path, b"index", &index_path)
        var index = try Index.load(try index_path.terminated())
        defer index.close()
        var numbers: Records[u32]
        defer numbers.close()
        try read_set(uids, &numbers)
        for uid in numbers.view():
            if remove:
                index.remove(uid)
            elif let at = index.find(uid):
                var row = index.rows.at(at)
                row.flags = (row.flags | bits) if add else (row.flags & ~bits)
                index.rows.set(at, row)
                index.changed = true
        if index.changed:
            try index.save(try index_path.terminated())
            self.post("folder", path)

    ## Send the message in `file` from `sender` to the comma-separated `recipients`.
    mutating func send(file: const u8[], sender: const u8[], recipients: const u8[]):
        self.send_message(file, sender, recipients) catch failure:
            self.post("unsent", file, failure.message.bytes)
            recover ()

    mutating func send_message(file: const u8[], sender: const u8[], recipients: const u8[]) -> !:
        self.post("status", b"Sending")
        var path: Buffer
        defer path.close()
        try path.put(file)
        let data = try files.read(try path.terminated())
        defer free(data)
        var list: Records[str]
        defer list.close()
        var start: usize = 0
        for at in 0..<recipients.length + 1:
            if at == recipients.length or recipients[at] == ',':
                if at > start:
                    try list.add(try self.text.keep_text(recipients[start..<at]))
                start = at + 1
        var client = try smtp.Client.open(self.account.smtp_host, self.account.smtp_port, self.account.smtp_security, cancellation = &self.room.quit)
        defer client.close()
        if self.account.smtp_user.length > 0:
            try client.login(self.account.smtp_user, self.account.smtp_password)
        discard(try client.send((str)sender, list.view(), data))
        client.quit()
        # A copy in the Sent folder, unless the server files one itself (it does not
        # say; Gmail does, most do not).
        if self.folders.length() == 0:
            try self.list_folders()
        if let sent = self.sent_folder():
            discard(self.session.append(sent, data, imap.Flags.seen) catch failure:
                recover 0)
        self.post("sent", file)
        self.post("status", b"")

    ## The folder sent mail is filed in: the one marked \\Sent, else one named as
    ## servers without special-use name it.
    func sent_folder() -> str?:
        for folder in self.folders.view():
            if (folder.flags & (u32)imap.MailboxFlags.sent) != 0:
                return folder.path
        for name in ["Sent", "Sent Items", "Sent Messages", "Sent Mail", "INBOX.Sent"]:
            for folder in self.folders.view():
                if imap.same(folder.path.bytes, name.bytes):
                    return folder.path
        return none

    # mark: waiting ==============================================================================

    ## Wait in IDLE on INBOX until it has news, the window has a command, or a full sync
    ## is due; then bring INBOX up to date if it changed.
    mutating func watch() -> !:
        var inbox: usize? = none
        for at in 0..<self.folders.length():
            if imap.same(self.folders.at(at).path.bytes, b"INBOX"):
                inbox = at
        if inbox == none:
            self.pause()
            return
        let at = inbox else return
        discard(try self.select(b"INBOX"))
        self.session.take_events()
        let started = time.now()
        if try self.session.idle_start():
            while not self.room.has_command() and not self.room.stopped() and time.now() - started < full_sync_interval:
                if try self.session.idle_wait(idle_slice):
                    break
            try self.session.idle_done()
        else:
            try self.session.noop()
            if not self.session.has_events():
                self.pause()
        if self.session.has_events():
            self.session.take_events()
            try self.sync_folder(at)
            try self.save_folders()
            self.post("folders")

    pub mutating func close():
        if self.online:
            self.session.logout()
        self.online = false
        self.text.close()
        self.folders.close()
        self.folder_text.close()
        self.selected.close()

## The row a message list needs from a fetched header.
func summarize(record: const imap.Fetched*, index: Index*) -> Row!:
    var message = try mime.Message.read(record.header)
    defer message.close()
    let sender = try message.address_line("From", short = true)
    let date = message.date_seconds()
    return Row(uid = record.uid, flags = (u16)record.flags, date = date if date != 0 else record.internal_date,
               size = (u32)record.size, attachment = try message.part_type(0) == "multipart/mixed",
               sender = try index.keep(sender.bytes), subject = try index.keep((try message.subject()).bytes),
               message_id = try index.keep((try message.message_id()).bytes),
               in_reply_to = try index.keep((try message.in_reply_to()).bytes), preview = "")

## The UIDs of sequence set `text` (`4:7,9`) onto `out`.
func read_set(text: const u8[], out: Records[u32]*) -> !:
    var index: usize = 0
    while index < text.length:
        var first: u32 = 0
        while index < text.length and text[index] >= '0' and text[index] <= '9':
            first = first * 10 + (u32)(text[index] - '0')
            index += 1
        var last = first
        if index < text.length and text[index] == ':':
            index += 1
            last = 0
            while index < text.length and text[index] >= '0' and text[index] <= '9':
                last = last * 10 + (u32)(text[index] - '0')
                index += 1
        var value = first
        while value <= last and value - first < 100000:
            try out.add(value)
            value += 1
        index += 1
