## What the window reads from the store: a folder list and a folder's message index,
## each loaded whole into an object Luce holds, with one accessor per column. Reading
## them in Base keeps a 50,000-message folder quick to open.
import c
import luce_std.files
import interop
import memory
from engine_text import Buffer, Pool, Records, Fields, equal
from mail_store import Index, Row, Folder
from mail_threads import Threads, thread

## A folder's messages, as the store has them, sorted by UID.
pub struct MessageIndex:
    var index: Index
    ## Positions newest first: by date, then by UID.
    var order: Records[u32]
    ## The messages grouped into conversations.
    var threads: Threads

    ## How many messages there are.
    pub func count() -> i64:
        return (i64)self.index.rows.length()

    func row(at: i64) -> Row:
        if at < 0 or at >= (i64)self.index.rows.length():
            trap("no message at that position in the index")
        return self.index.rows.at((usize)at)

    pub func uid(at: i64) -> i64:
        return (i64)self.row(at).uid
    ## imap.Flags bits: 1 seen, 2 answered, 4 flagged, 8 deleted, 16 draft, 64 forwarded, 128 junk.
    pub func flags(at: i64) -> i64:
        return (i64)self.row(at).flags
    ## Seconds since 1970 UTC.
    pub func date(at: i64) -> i64:
        return self.row(at).date
    pub func size(at: i64) -> i64:
        return (i64)self.row(at).size
    pub func attachment(at: i64) -> bool:
        return self.row(at).attachment
    pub func sender(at: i64) -> str:
        return self.row(at).sender
    pub func subject(at: i64) -> str:
        return self.row(at).subject
    pub func message_id(at: i64) -> str:
        return self.row(at).message_id
    pub func in_reply_to(at: i64) -> str:
        return self.row(at).in_reply_to
    pub func preview(at: i64) -> str:
        return self.row(at).preview

    ## The position of the message with UID `uid`, or -1.
    pub func position(uid: i64) -> i64:
        if uid < 0 or uid > 0xFFFFFFFF:
            return -1
        let at = self.index.find((u32)uid) else return -1
        return (i64)at

    ## The position of the `nth` newest message.
    pub func newest(nth: i64) -> i64:
        if nth < 0 or nth >= (i64)self.order.length():
            trap("no message at that place in the order")
        return (i64)self.order.at((usize)nth)

    ## Order the positions newest first (a merge sort: stable, and fast on the mostly
    ## sorted orders mailboxes have).
    mutating func sort() -> !:
        let count = self.index.rows.length()
        self.order.clear()
        for at in 0..<count:
            try self.order.add((u32)at)
        if count < 2:
            return
        let scratch = try alloc u32[count] in memory.heap
        defer free(scratch) in memory.heap
        var width: usize = 1
        while width < count:
            var start: usize = 0
            while start < count:
                let middle = start + width if start + width < count else count
                let end = start + 2 * width if start + 2 * width < count else count
                var left = start
                var right = middle
                var out = start
                while out < end:
                    let take_left = right >= end or (left < middle and not self.newer(self.order.at(right), self.order.at(left)))
                    if take_left:
                        scratch[out] = self.order.at(left)
                        left += 1
                    else:
                        scratch[out] = self.order.at(right)
                        right += 1
                    out += 1
                start = end
            for at in 0..<count:
                self.order.set(at, scratch[at])
            width *= 2

    ## Whether the row at `a` is newer than the row at `b`.
    func newer(a: u32, b: u32) -> bool:
        let first = self.index.rows.at((usize)a)
        let second = self.index.rows.at((usize)b)
        if first.date != second.date:
            return first.date > second.date
        return first.uid > second.uid

    # mark: conversations ======================================================================

    ## How many conversations there are.
    pub func thread_count() -> i64:
        return (i64)self.threads.count()

    func checked_thread(nth: i64) -> usize:
        if nth < 0 or nth >= (i64)self.threads.count():
            trap("no conversation at that place")
        return (usize)nth

    ## How many messages conversation `nth` (newest first) holds.
    pub func thread_size(nth: i64) -> i64:
        return (i64)self.threads.size(self.checked_thread(nth))

    ## The position of the `member`-th newest message of conversation `nth`.
    pub func thread_member(nth: i64, member: i64) -> i64:
        let group = self.checked_thread(nth)
        if member < 0 or member >= (i64)self.threads.size(group):
            trap("no message at that place in the conversation")
        return (i64)self.threads.member(group, (usize)member)

    ## Whether any message of conversation `nth` has all of flag bits `bit`
    ## (`seen` asks for the inverse: whether any is unread).
    pub func thread_any(nth: i64, bit: i64, wanted: bool) -> bool:
        let group = self.checked_thread(nth)
        for member in 0..<self.threads.size(group):
            let flags = (i64)self.index.rows.at((usize)self.threads.member(group, member)).flags
            if ((flags & bit) == bit) == wanted:
                return true
        return false

    ## Whether any message of conversation `nth` has attachments.
    pub func thread_attachment(nth: i64) -> bool:
        let group = self.checked_thread(nth)
        for member in 0..<self.threads.size(group):
            if self.index.rows.at((usize)self.threads.member(group, member)).attachment:
                return true
        return false

    pub mutating func close():
        self.index.close()
        self.order.close()
        self.threads.close()

pub let message_index_type: interop.Type[MessageIndex] = interop.Type[MessageIndex]("Message index", MessageIndex.close, closeable = true)

## Read the index file at `path`; empty when there is none.
pub func read_index(path: str) -> interop.Reference[MessageIndex]!:
    var name: Buffer
    defer name.close()
    try name.text(path)
    let native = try new MessageIndex(index = try Index.load(try name.terminated())) in memory.heap
    errdefer free(native) in memory.heap
    try native.sort()
    native.threads = try thread(&native.index)
    return try interop.Reference[MessageIndex].adopt(native, message_index_type)

## The folders of one account, as the engine listed them.
pub struct FolderList:
    var folders: Records[Folder]
    var text: Pool

    pub func count() -> i64:
        return (i64)self.folders.length()

    func folder(at: i64) -> Folder:
        if at < 0 or at >= (i64)self.folders.length():
            trap("no folder at that position")
        return self.folders.at((usize)at)

    ## The server's name for folder `at`, used in commands.
    pub func path(at: i64) -> str:
        return self.folder(at).path
    ## The name to show.
    pub func name(at: i64) -> str:
        return self.folder(at).name
    ## The hierarchy delimiter as a character code, zero for none.
    pub func delimiter(at: i64) -> i64:
        return (i64)self.folder(at).delimiter
    ## imap.MailboxFlags bits: 256 all, 512 archive, 1024 drafts, 2048 flagged, 4096 junk,
    ## 8192 sent, 16384 trash.
    pub func flags(at: i64) -> i64:
        return (i64)self.folder(at).flags
    ## How many levels down folder `at` is: the delimiters in its path.
    pub func depth(at: i64) -> i64:
        let folder = self.folder(at)
        if folder.delimiter == 0:
            return 0
        var count: i64 = 0
        for byte in folder.path.bytes:
            if byte == folder.delimiter:
                count += 1
        return count

    ## The last part of folder `at`'s name: `2026` for `Archive/2026`.
    pub func leaf(at: i64) -> str:
        let folder = self.folder(at)
        if folder.delimiter == 0:
            return folder.name
        let data = folder.name.bytes
        var start: usize = 0
        for index in 0..<data.length:
            if data[index] == folder.delimiter:
                start = index + 1
        return (str)data[start..]

    ## The folder's directory name in the store.
    pub func key(at: i64) -> str:
        return self.folder(at).key
    pub func total(at: i64) -> i64:
        return (i64)self.folder(at).total
    pub func unseen(at: i64) -> i64:
        return (i64)self.folder(at).unseen

    pub mutating func close():
        self.folders.close()
        self.text.close()

pub let folder_list_type: interop.Type[FolderList] = interop.Type[FolderList]("Folder list", FolderList.close, closeable = true)

## Read the folders file at `path`; empty when there is none.
pub func read_folders(path: str) -> interop.Reference[FolderList]!:
    let native = try new FolderList in memory.heap
    errdefer free(native) in memory.heap
    var name: Buffer
    defer name.close()
    try name.text(path)
    let file = try name.terminated()
    if files.exists(file):
        let data: u8[]? = files.read(file) catch failure:
            recover none
        if let bytes = data:
            defer free(bytes)
            try read_folder_lines(bytes, native)
    return try interop.Reference[FolderList].adopt(native, folder_list_type)

func read_folder_lines(bytes: const u8[], list: FolderList*) -> !:
    var scratch: Buffer
    defer scratch.close()
    var start: usize = 0
    var first = true
    for at in 0..<bytes.length + 1:
        if at < bytes.length and bytes[at] != '\n':
            continue
        let line = bytes[start..<at]
        start = at + 1
        if line.length == 0:
            continue
        if first:
            first = false
            continue
        let fields = Fields.split(line)
        if fields.length() < 7:
            continue
        scratch.clear()
        try fields.unescape(0, &scratch)
        let path = try list.text.keep_text(scratch.view())
        scratch.clear()
        try fields.unescape(1, &scratch)
        let name = try list.text.keep_text(scratch.view())
        let key = try list.text.keep_text(fields.raw(4))
        try list.folders.add(Folder(path = path, name = name, delimiter = (u8)fields.number(2), flags = (u32)fields.number(3),
                                    key = key, total = (u32)fields.number(5), unseen = (u32)fields.number(6)))

## Whether a file or directory exists at `path`.
pub func exists(path: str) -> bool:
    var name: Buffer
    defer name.close()
    name.text(path) catch failure:
        return false
    let file = name.terminated() catch failure:
        return false
    return files.exists(file)

## Whether flag word `flags` has every bit of `bit` set: Luce has no bit operations.
pub func has(flags: i64, bit: i64) -> bool:
    return (flags & bit) == bit
